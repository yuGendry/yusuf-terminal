# Copy to .env and fill in. These are not secret (the Stripe secret keys are set with `firebase functions:secrets:set`).
# The Stripe Price ID of your Pro plan, from Stripe Dashboard → Product catalog → Loadout Pro → price (starts with price_).
STRIPE_PRICE_ID=price_YOUR_PRICE_ID
# Your website's address, with no trailing slash. Checkout sends people back here.
SITE_URL=https://YOUR_PROJECT_ID.web.app
