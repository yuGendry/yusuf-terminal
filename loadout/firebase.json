{
  "hosting": {
    "public": "site",
    "ignore": ["**/.*"],
    "headers": [
      { "source": "img/**", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }] },
      { "source": "**", "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ] }
    ]
  },
  "firestore": { "rules": "backend/firestore.rules" },
  "functions": [{ "source": "backend/functions", "codebase": "default", "runtime": "nodejs22", "ignore": ["node_modules", ".env.local"] }],
  "emulators": { "auth": { "port": 9099 }, "firestore": { "port": 8080 }, "functions": { "port": 5001 }, "hosting": { "port": 5000 }, "ui": { "enabled": true } }
}
